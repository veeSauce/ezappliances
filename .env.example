# Copy this file to .env and fill in real values.
# Never commit the actual .env file to git — it's already in .gitignore.

PORT=3000

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_with_real_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_secret

# Postgres — used to build DATABASE_URL below and by the postgres_db container
POSTGRES_USER=ez_admin
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=ezappliances
DATABASE_URL=postgresql://ez_admin:replace_with_a_strong_password@postgres_db:5432/ezappliances

# Admin auth is now validated directly against the Postgres admin_users table.
